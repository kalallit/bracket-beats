{
  "name": "bracket-beats",
  "displayName": "Bracket Beats for Spotify",
  "description": "%ext.description%",
  "version": "0.9.2",
  "publisher": "Kalallit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalallit/bracket-beats"
  },
  "bugs": {
    "url": "https://github.com/kalallit/bracket-beats/issues"
  },
  "homepage": "https://github.com/kalallit/bracket-beats#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bracketBeats.login",
        "title": "%cmd.login%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.setup",
        "title": "%cmd.setup%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.logout",
        "title": "%cmd.logout%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.togglePlay",
        "title": "%cmd.togglePlay%",
        "category": "Bracket Beats",
        "icon": "$(play)"
      },
      {
        "command": "bracketBeats.next",
        "title": "%cmd.next%",
        "category": "Bracket Beats",
        "icon": "$(chevron-right)"
      },
      {
        "command": "bracketBeats.previous",
        "title": "%cmd.previous%",
        "category": "Bracket Beats",
        "icon": "$(chevron-left)"
      },
      {
        "command": "bracketBeats.toggleLike",
        "title": "%cmd.toggleLike%",
        "category": "Bracket Beats",
        "icon": "$(heart)"
      },
      {
        "command": "bracketBeats.toggleShuffle",
        "title": "%cmd.toggleShuffle%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.cycleRepeat",
        "title": "%cmd.cycleRepeat%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.volumeUp",
        "title": "%cmd.volumeUp%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.volumeDown",
        "title": "%cmd.volumeDown%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.pickDevice",
        "title": "%cmd.pickDevice%",
        "category": "Bracket Beats",
        "icon": "$(device-desktop)"
      },
      {
        "command": "bracketBeats.showQueue",
        "title": "%cmd.showQueue%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.search",
        "title": "%cmd.search%",
        "category": "Bracket Beats",
        "icon": "$(search)"
      },
      {
        "command": "bracketBeats.suggest",
        "title": "%cmd.suggest%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.openPicker",
        "title": "%cmd.openPicker%",
        "category": "Bracket Beats",
        "icon": "$(sparkle)"
      },
      {
        "command": "bracketBeats.bindProject",
        "title": "%cmd.bindProject%",
        "category": "Bracket Beats",
        "icon": "$(pinned)"
      },
      {
        "command": "bracketBeats.focus",
        "title": "%cmd.focus%",
        "category": "Bracket Beats",
        "icon": "$(target)"
      },
      {
        "command": "bracketBeats.saveSession",
        "title": "%cmd.saveSession%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.showProfile",
        "title": "%cmd.showProfile%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.clearHistory",
        "title": "%cmd.clearHistory%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.unhidePlaylists",
        "title": "%cmd.unhidePlaylists%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.setVolume",
        "title": "%cmd.setVolume%",
        "category": "Bracket Beats"
      },
      {
        "command": "bracketBeats.seek",
        "title": "%cmd.seek%",
        "category": "Bracket Beats"
      }
    ],
    "keybindings": [
      {
        "command": "bracketBeats.openPicker",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "bracketBeats.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "title": "Bracket Beats",
      "properties": {
        "bracketBeats.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "Português",
            "English"
          ],
          "default": "auto",
          "description": "%cfg.language%",
          "order": 0
        },
        "bracketBeats.clientId": {
          "type": "string",
          "default": "",
          "description": "%cfg.clientId%",
          "order": 1
        },
        "bracketBeats.redirectPort": {
          "type": "number",
          "default": 8888,
          "description": "%cfg.redirectPort%"
        },
        "bracketBeats.suggestOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.suggestOnStartup%"
        },
        "bracketBeats.suggestionStyle": {
          "type": "string",
          "enum": [
            "card",
            "modal",
            "quickpick",
            "notification"
          ],
          "enumDescriptions": [
            "%cfg.style.card%",
            "%cfg.style.modal%",
            "%cfg.style.quickpick%",
            "%cfg.style.notification%"
          ],
          "default": "card",
          "description": "%cfg.style%"
        },
        "bracketBeats.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "%cfg.pollInterval%"
        },
        "bracketBeats.statusBarButtons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "suggestions",
              "previous",
              "next",
              "like"
            ]
          },
          "default": [
            "suggestions",
            "previous",
            "next",
            "like"
          ],
          "uniqueItems": true,
          "description": "%cfg.statusBarButtons%"
        },
        "bracketBeats.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.history%"
        },
        "bracketBeats.focus.workMinutes": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 180,
          "description": "%cfg.focusWork%"
        },
        "bracketBeats.focus.breakMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "%cfg.focusBreak%"
        },
        "bracketBeats.focus.pauseOnBreak": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.focusPause%"
        },
        "bracketBeats.hiddenMoods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "foco",
              "code",
              "energia",
              "chill",
              "feliz",
              "melancolia",
              "noite"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "%cfg.hiddenMoods%"
        },
        "bracketBeats.customMoods": {
          "type": "array",
          "default": [],
          "markdownDescription": "%cfg.customMoods%",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "%cfg.cm.label%"
              },
              "emoji": {
                "type": "string",
                "description": "%cfg.cm.emoji%"
              },
              "query": {
                "type": "string",
                "description": "%cfg.cm.query%"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%cfg.cm.keywords%"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "%cfg.cm.color%"
              }
            }
          }
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "bracketBeats.setVolume",
          "when": "false"
        },
        {
          "command": "bracketBeats.seek",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "bracketBeats.search",
          "when": "view == bracketBeats.player",
          "group": "navigation@1"
        },
        {
          "command": "bracketBeats.openPicker",
          "when": "view == bracketBeats.player",
          "group": "navigation@2"
        },
        {
          "command": "bracketBeats.pickDevice",
          "when": "view == bracketBeats.player",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bracketBeats",
          "title": "Bracket Beats",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "bracketBeats": [
        {
          "type": "webview",
          "id": "bracketBeats.player",
          "name": "%view.player%"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run compile && node --test \"test/*.test.js\"",
    "vscode:prepublish": "npm run compile && node scripts/check-brand.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "icon": "media/icon.png",
  "extensionKind": [
    "ui"
  ],
  "galleryBanner": {
    "color": "#0d1017",
    "theme": "dark"
  },
  "keywords": [
    "spotify",
    "spotify player",
    "music",
    "music player",
    "player",
    "now playing",
    "playlist",
    "lofi",
    "focus",
    "pomodoro",
    "productivity",
    "coding music",
    "status bar",
    "sidebar"
  ]
}
